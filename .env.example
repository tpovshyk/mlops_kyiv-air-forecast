# Скопіюй у .env (cp .env.example .env) і заміни паролі. .env у Git не потрапляє.

# PostgreSQL: сховище даних і бекенди Airflow та MLflow
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warehouse

# MinIO: DVC remote і артефакти MLflow (пароль щонайменше 8 символів)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too

# Клієнт MLflow на ноутбуці (навчання, реєстрація, відтворення)
MLFLOW_TRACKING_URI=http://localhost:5050
# Завантажувати артефакти через сервер, а не за адресою minio:9000, яку ноутбук не бачить
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
